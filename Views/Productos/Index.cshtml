@{
    ViewData["Title"] = "Catálogo de Productos - Infinity Core";
}

<div class="container py-4">
    <!-- Encabezado del Catálogo -->
    <div class="border-bottom pb-3 mb-4">
        <h1 class="fw-bold text-dark">Catálogo de Productos</h1>
        <p class="text-muted mb-0">Explora componentes electrónicos organizados por categoría</p>
    </div>

    <div class="row g-4">
        <!-- BARRA LATERAL: Categorías y Filtros -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Categorías</h5>
                    
                    <!-- Menú de Categorías -->
                    <div class="list-group list-group-flush mb-4">
                        <a href="#" class="list-group-item list-group-item-action active fw-semibold" aria-current="true">
                            Todas las categorías
                        </a>
                        <a href="#" class="list-group-item list-group-item-action">Microcontroladores y Dev Boards</a>
                        <a href="#" class="list-group-item list-group-item-action">Sensores y Módulos</a>
                        <a href="#" class="list-group-item list-group-item-action">Componentes Pasivos</a>
                        <a href="#" class="list-group-item list-group-item-action">Semiconductores y CI</a>
                        <a href="#" class="list-group-item list-group-item-action">Impresión 3D y Robótica</a>
                        <a href="#" class="list-group-item list-group-item-action">Herramientas e Instrumentación</a>
                    </div>

                    <!-- Filtro Secundario: Ordenar o Disponibilidad -->
                    <h6 class="fw-bold mb-2">Disponibilidad</h6>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="stockOnly">
                        <label class="form-check-label small text-secondary" for="stockOnly">
                            En stock
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <!-- CONTENIDO PRINCIPAL: Contenedores por Categoría -->
        <div class="col-lg-9">
            
            <!-- Barra superior de ordenamiento -->
            <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-3 shadow-sm mb-4 border">
                <span class="text-muted small">Mostrando secciones de catálogo</span>
                <div class="d-flex align-items-center gap-2">
                    <label class="small text-muted text-nowrap">Ordenar por:</label>
                    <select class="form-select form-select-sm">
                        <option>Relevancia</option>
                        <option>Precio: Menor a Mayor</option>
                        <option>Precio: Mayor a Menor</option>
                        <option>Más recientes</option>
                    </select>
                </div>
            </div>

            <!-- SECCIÓN 1: Microcontroladores -->
            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <h3 class="h5 fw-bold mb-0">Microcontroladores y Placas de Desarrollo</h3>
                    <a href="#" class="text-decoration-none small fw-semibold text-dark">Ver todos los de esta categoría &rarr;</a>
                </div>
                
                <!-- Rejilla de marcadores de posición para productos -->
                <div class="row row-cols-1 row-cols-md-3 g-3">
                    <div class="col">
                        <div class="card h-100 border text-center p-4 bg-light text-muted rounded-3">
                            <span class="fw-semibold"></span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100 border text-center p-4 bg-light text-muted rounded-3">
                            <span class="fw-semibold"></span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100 border text-center p-4 bg-light text-muted rounded-3">
                            <span class="fw-semibold"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 2: Sensores y Módulos -->
            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <h3 class="h5 fw-bold mb-0">Sensores y Módulos</h3>
                    <a href="#" class="text-decoration-none small fw-semibold text-dark">Ver todos los de esta categoría &rarr;</a>
                </div>
                
                <div class="row row-cols-1 row-cols-md-3 g-3">
                    <div class="col">
                        <div class="card h-100 border text-center p-4 bg-light text-muted rounded-3">
                            <span class="fw-semibold"></span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100 border text-center p-4 bg-light text-muted rounded-3">
                            <span class="fw-semibold"></span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100 border text-center p-4 bg-light text-muted rounded-3">
                            <span class="fw-semibold"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 3: Componentes Pasivos -->
            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <h3 class="h5 fw-bold mb-0">Componentes Pasivos (Resistencias, Capacitores)</h3>
                    <a href="#" class="text-decoration-none small fw-semibold text-dark">Ver todos los de esta categoría &rarr;</a>
                </div>
                
                <div class="row row-cols-1 row-cols-md-3 g-3">
                    <div class="col">
                        <div class="card h-100 border text-center p-4 bg-light text-muted rounded-3">
                            <span class="fw-semibold"></span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100 border text-center p-4 bg-light text-muted rounded-3">
                            <span class="fw-semibold"></span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100 border text-center p-4 bg-light text-muted rounded-3">
                            <span class="fw-semibold"></span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
