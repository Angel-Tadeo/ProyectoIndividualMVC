@{
    ViewData["Title"] = "Iniciar Sesión - Infinity Core";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4 p-sm-5">
                    
                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-dark">Iniciar Sesión</h2>
                        <p class="text-muted small">Ingresa tus credenciales para acceder a tu cuenta de Infinity Core</p>
                    </div>

                    <form asp-controller="Account" asp-action="Login" method="post">
                        
                        <!-- Correo Electrónico -->
                        <div class="mb-3">
                            <label for="email" class="form-label text-secondary fw-semibold small">Correo Electrónico</label>
                            <input type="email" class="form-control" id="email" name="Email" placeholder="usuario@ejemplo.com" required />
                        </div>

                        <!-- Contraseña -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label for="password" class="form-label text-secondary fw-semibold small mb-0">Contraseña</label>
                                <a href="#" class="text-decoration-none small text-muted">¿Olvidaste tu contraseña?</a>
                            </div>
                            <input type="password" class="form-control" id="password" name="Password" placeholder="••••••••" required />
                        </div>

                        <!-- Recordar Sesión -->
                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" id="rememberMe" name="RememberMe" />
                            <label class="form-check-label text-secondary small" for="rememberMe">
                                Recordar mi sesión
                            </label>
                        </div>

                        <!-- Botón de Ingreso -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-dark btn-lg fs-6 fw-bold">Entrar</button>
                        </div>

                        <!-- Enlace a Registro -->
                        <div class="text-center mt-4">
                            <span class="text-muted small">¿Aún no tienes cuenta?</span>
                            <a asp-controller="Cuenta" asp-action="registro" class="text-decoration-none fw-bold text-dark ms-1 small">Regístrate aquí</a>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>